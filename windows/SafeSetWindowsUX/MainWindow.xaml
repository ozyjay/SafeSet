<Window
    x:Class="SafeSetWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SafeSet">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="18" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Protect workbook" Tag="protectWorkbook">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Protect document" Tag="protectDocument">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Restore workbook" Tag="restoreWorkbook">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Restore document" Tag="restoreDocument">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="advanced">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Help" Tag="help">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24,18,24,24" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="StatusBar"
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Development preview — synthetic testing only"
                    Message="Use synthetic files while native Windows interactions are being verified. Every publication requires validation, review and explicit approval. Release workflows remain disabled." />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1080" HorizontalAlignment="Left">

                        <!-- HOME -->
                        <StackPanel x:Name="HomePage" Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Protect, work, restore"
                                           Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock
                                    Text="Prepare protected working copies for analysis or review, then restore approved identifiers locally."
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    MaxWidth="760" />
                            </StackPanel>

                            <Grid ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Grid.Column="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="20"
                                        CornerRadius="12"
                                        Click="HomeProtectWorkbook_Click">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Protect a workbook"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Prepare tabular data for controlled external analysis."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="0" Grid.Column="1"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="20"
                                        CornerRadius="12"
                                        Click="HomeProtectDocument_Click">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Protect a document"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Prepare a DOCX manuscript for external review or AI-assisted work."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="20"
                                        CornerRadius="12"
                                        Click="HomeRestoreWorkbook_Click">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Restore a workbook"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Bring approved analysis results back into a new local identifiable workbook."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="1"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="20"
                                        CornerRadius="12"
                                        Click="HomeRestoreDocument_Click">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Restore a document"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Restore SafeSet protection tokens into a new local DOCX."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Padding="18"
                                    CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Safety boundary"
                                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="Passing SafeSet checks can reduce disclosure risk. It does not establish anonymity, legal compliance or recipient suitability. Human review remains required."
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PROTECT WORKBOOK -->
                        <StackPanel x:Name="ProtectWorkbookPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Protect a workbook" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="Protect one worksheet using an explicit YAML policy. Every field needs a classification and protection decision. Source fields remain immutable in this workflow." TextWrapping="Wrap" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="WorkbookSourcePath" Header="Original .xlsx workbook" />
                                    <Button Content="Browse workbook…" Click="BrowseWorkbookSource_Click" />
                                    <Button Content="Load worksheets" Click="LoadWorkbookSheets_Click" />
                                    <ComboBox x:Name="WorkbookSheet" Header="Worksheet to protect" HorizontalAlignment="Stretch" />
                                    <TextBox x:Name="WorkbookPolicyPath" Header="Protection policy (.yaml)" />
                                    <Button Content="Browse policy…" Click="BrowseWorkbookPolicy_Click" />
                                    <TextBox x:Name="WorkbookProtectedPath" Header="New protected .xlsx destination" />
                                    <Button Content="Choose protected destination…" Click="ChooseProtectedWorkbook_Click" />
                                    <TextBox x:Name="WorkbookBundlePath" Header="New private .enc bundle in a separate directory" />
                                    <Button Content="Choose private bundle destination…" Click="ChooseWorkbookBundle_Click" />
                                    <Button Content="Review workbook protection" Style="{StaticResource AccentButtonStyle}" Click="ProtectWorkbook_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PROTECT DOCUMENT -->
                        <StackPanel x:Name="ProtectDocumentPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Protect a document" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="Prepare a DOCX manuscript for external review or AI-assisted work while preserving the scholarly content."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="1. Original document" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DocumentSourcePath" PlaceholderText="Original .docx document" IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="Browse…" Click="BrowseDocumentSource_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="2. Known identities to protect" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="Add names or other identifiers you know should be protected. Email addresses and ORCIDs are detected automatically by the shared engine."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBox x:Name="DocumentIdentityTerms"
                                             PlaceholderText="One value per line"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="120" />
                                    <CheckBox x:Name="RemoveDocumentComments"
                                              Content="Remove Word comments from the protected copy"
                                              IsChecked="True" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="3. Output" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DocumentProtectedPath"
                                                 PlaceholderText="Protected .docx output"
                                                 IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="Choose…" Click="ChooseProtectedDocument_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DocumentBundlePath"
                                                 PlaceholderText="Private .enc restoration bundle"
                                                 IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="Choose…" Click="ChooseDocumentBundle_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Protection checks" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="28" RowSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Tracked changes" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Must be resolved before protection"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="Hidden text" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Blocks protection"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Text="Embedded/active content" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Blocks protection"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Text="Authoring metadata" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Removed from protected copy"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Button Content="Review document protection"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="ProtectDocument_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RESTORE WORKBOOK -->
                        <StackPanel x:Name="RestoreWorkbookPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Restore a workbook" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="Use the exact original workbook and matching private bundle. Review and explicitly approve every result field, analysis worksheet and changed field." TextWrapping="Wrap" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="WorkbookReturnedPath" Header="Returned protected .xlsx workbook" />
                                    <Button Content="Browse returned workbook…" Click="BrowseWorkbookReturned_Click" />
                                    <TextBox x:Name="WorkbookOriginalPath" Header="Exact original .xlsx workbook" />
                                    <Button Content="Browse original workbook…" Click="BrowseWorkbookOriginal_Click" />
                                    <TextBox x:Name="WorkbookOriginalSheet" Header="Original worksheet name (single worksheet workflow; optional for a one-sheet original)" />
                                    <TextBox x:Name="WorkbookRestoreBundlePath" Header="Matching private .enc bundle" />
                                    <Button Content="Browse private bundle…" Click="BrowseWorkbookRestoreBundle_Click" />
                                    <TextBox x:Name="WorkbookRestoredPath" Header="New identifiable .xlsx destination" />
                                    <Button Content="Choose restored destination…" Click="ChooseRestoredWorkbook_Click" />
                                    <CheckBox x:Name="WorkbookRelationalRestore" Content="Related sheets, editable workbook or confirmed-region bundle (versions 3–5)" />
                                    <Button Content="Review workbook restoration" Style="{StaticResource AccentButtonStyle}" Click="RestoreWorkbook_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RESTORE DOCUMENT -->
                        <StackPanel x:Name="RestoreDocumentPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Restore a document" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="Restore protected identities only when every SafeSet token survives the returned DOCX exactly."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Returned protected document" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DocumentReturnedPath" PlaceholderText="Modified protected .docx" IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="Browse…" Click="BrowseDocumentReturned_Click" />
                                    </Grid>

                                    <TextBlock Text="Private restoration bundle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DocumentRestoreBundlePath" PlaceholderText="Private .enc bundle" IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="Browse…" Click="BrowseDocumentRestoreBundle_Click" />
                                    </Grid>

                                    <TextBlock Text="Restored output" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DocumentRestoredPath" PlaceholderText="New local .docx output" IsReadOnly="False" />
                                        <Button Grid.Column="1" Content="Choose…" Click="ChooseRestoredDocument_Click" />
                                    </Grid>

                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                                             Message="SafeSet will never guess a missing or altered token. Any mismatch blocks restoration." />
                                    <Button Content="Review restoration"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="RestoreDocument_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ADVANCED -->
                        <StackPanel x:Name="AdvancedPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Advanced" Style="{ThemeResource TitleTextBlockStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Shared engine" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Desktop contract: bounded JSON-line protocol over local stdin/stdout"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Runtime network requirement: none"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Safety decisions: shared Python engine"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Windows release gate" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                                             Title="Private NTFS storage"
                                             Message="The shared engine enforces restricted NTFS ACLs. Existing permissive private directories are rejected; use a new private bundle subdirectory separate from exports." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- HELP -->
                        <StackPanel x:Name="HelpPage" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Help" Style="{ThemeResource TitleTextBlockStyle}" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Using this Windows build" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Choose local fixed NTFS storage. Keep originals, bundles and restored documents private, outside repositories and cloud synchronisation."
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Document protection includes local paragraph and figure review. Workbook protection currently uses one worksheet and an explicit YAML policy. Use the CLI for related-sheet protection, editable workbook creation and advanced workflows. Review the protected copy before sharing it."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
