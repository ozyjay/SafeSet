{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SafeSet: Build macOS Debug",
            "type": "process",
            "command": "pwsh",
            "osx": {
                "command": "/opt/homebrew/bin/pwsh"
            },
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-File",
                "${workspaceFolder}/scripts/build-macos-app.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
