{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SafeSet: Build macOS Release",
            "type": "process",
            "command": "pwsh",
            "osx": {
                "command": "/opt/homebrew/bin/pwsh"
            },
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-File",
                "${workspaceFolder}/scripts/build-macos-app.ps1",
                "-Configuration",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "close": false
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "SafeSet: Build macOS Debug",
            "type": "process",
            "command": "pwsh",
            "osx": {
                "command": "/opt/homebrew/bin/pwsh"
            },
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-File",
                "${workspaceFolder}/scripts/build-macos-app.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "SafeSet: Build and run macOS Debug",
            "type": "process",
            "command": "/usr/bin/open",
            "args": ["-n", "-a", "${workspaceFolder}/dist/SafeSet.app"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "SafeSet: Build macOS Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
